# 复制为 backend/.env 使用;key 不入库不入 git
# LLM:OpenAI 兼容协议,默认 GLM Coding Plan 专用端点(勿用通用 v4)
BO_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
BO_LLM_API_KEY=
BO_LLM_MODEL=glm-5.3-flash

# Embedding:硅基流动 BAAI/bge-m3(OpenAI 兼容,1024 维)
BO_EMBED_BASE_URL=https://api.siliconflow.cn/v1
BO_EMBED_API_KEY=
BO_EMBED_MODEL=BAAI/bge-m3

# 测试/E2E 开关
# BO_STUB_LLM=1        # 用本地 stub 替代真实 LLM/embedding
# BO_FAKE_TODAY=2026-11-20  # 模拟"今天",E2E 时间跳跃用
